option('install_subdir', type : 'string', value : 'android/arm64', description: 'platform/arch specific subdirectory to install the libraries in unity')
option('libmaf', type : 'boolean', value : true, description: 'build libmaf')
option('csharp', type : 'boolean', value : true, description: 'build csharp bindings')
option('avpipeline', type : 'boolean', value : false, description: 'build avpipeline plugin')
option('unityplugin', type : 'feature', value : 'auto', description: 'build the maf_unity Unity native rendering plugin (needs the PluginAPI headers of a Unity installation)')
